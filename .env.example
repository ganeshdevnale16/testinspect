# ---------- required in production ----------
NODE_ENV=production
# PostgreSQL (Neon / Supabase / Render Postgres). Without it a local SQLite file is used (testing only).
DATABASE_URL=postgres://user:password@host:5432/dbname
# Long random strings. Generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=change-me-long-random
ENCRYPTION_KEY=change-me-another-long-random   # protects customer AI keys - never change it after go-live
# Your platform owner login (created on first start)
SUPERADMIN_EMAIL=you@yourcompany.com
SUPERADMIN_PASSWORD=Choose-A-Strong-Pass1

# ---------- optional ----------
APP_NAME=Inspection AI
SESSION_DAYS=14
MIN_CONFIDENCE=0.7
STRICT_VERIFY=1
# Platform AI keys (used only for clients whose plan includes "platform AI"). You can also add these in Console > Platform AI keys.
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com
# AZURE_OPENAI_API_KEY=
# AZURE_OPENAI_DEPLOYMENT=gpt-4o
# AZURE_OPENAI_API_VERSION=2024-10-21
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
# Demo mode: fake AI answers, no key needed. NEVER on for real customers.
# AI_MOCK=1
